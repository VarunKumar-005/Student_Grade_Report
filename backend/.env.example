# .env.example — Copy to .env and fill in your values
# This file is safe to commit to version control.

APP_NAME=Student Mark Attainment System
ENV=dev

# For local SQLite dev (auto-created):
DATABASE_URL=sqlite:///./student_grade_report.db

# For Neon PostgreSQL (production):
# DATABASE_URL=postgresql+psycopg2://user:password@ep-xxx.neon.tech/dbname?sslmode=require

# JWT — CHANGE THIS IN PRODUCTION
JWT_SECRET=change-this-to-a-long-random-secret-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120
