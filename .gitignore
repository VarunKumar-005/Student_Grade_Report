# =============================================================================
# Git Ignore — Student Grade Report & CO Attainment System
# =============================================================================

# Environments & Secrets (DO NOT COMMIT CREDENTIALS)
.env
*.env
!.env.example

# Python Bytecode & Cache
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Virtual Environments
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# Testing & Coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
nosetests.xml
coverage.xml

# Local Database Files
*.db
*.sqlite3
*.sqlite
backend/*.db

# Logs & Temporary Files
*.log
logs/
scratch/

# IDE & Editor Settings
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo

# Operating System Files
.DS_Store
Thumbs.db
Desktop.ini
$RECYCLE.BIN/

# Node / Frontend (for future web app builds)
node_modules/
dist/
build/
.next/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
